{
  "name": "comisiones-ashley",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "node --test tests/domain.test.mjs tests/migrations.test.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "postinstall": "prisma generate",
    "setup": "node scripts/setup.mjs",
    "db:remote": "node scripts/migrate-remote.mjs",
    "vercel-build": "prisma generate && npm run db:remote && next build",
    "test:mobile": "node tests/mobile.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-better-sqlite3": "^6.19.0",
